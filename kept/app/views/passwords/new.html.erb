<% content_for :title, "Reset your password · Kept" %>
<h1 class="auth-title">Forgot your password?</h1>
<section class="card">
  <p class="small muted">Enter the email you signed up with. If there's an account, we'll send a link that works for 15 minutes.</p>
  <%= form_with url: passwords_path do |form| %>
    <div class="field"><%= form.label :email_address, "Email" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %></div>
    <%= form.submit "Email me a reset link", class: "btn btn-primary btn-block" %>
  <% end %>
  <p class="hint center mt"><%= link_to "Back to sign in", new_session_path %></p>
</section>
