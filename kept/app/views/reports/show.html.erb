<% content_for :title, "Report for my clinician" %>
<% med = @o.medication; s = @o.schedule; tr = @o.trend %>
<p style="color:#555;font-size:12px">Generated by Kept on <%= Date.current.strftime("%B %-d, %Y") %> from self-reported logs. Not a medical record.</p>
<h1><%= current_user.name.presence || "Patient" %> — GLP-1 progress summary</h1>
<table style="margin:10px 0 18px">
  <tr><th>Medication</th><td><%= med.info.brand %> (<%= med.info.generic %>) <%= mg med.dose_mg %>, <%= med.info.frequency %>; started <%= med.started_on.strftime("%b %-d, %Y") %>; current dose since <%= med.dose_started_on.strftime("%b %-d, %Y") %></td></tr>
  <tr><th>Adherence (8 weeks)</th><td><%= s.adherence_pct %>% of expected doses logged</td></tr>
  <tr><th>Weight</th><td>Start <%= weight(tr.start_weight) %> → trend <%= weight(tr.current_trend) %> (−<%= tr.total_loss_pct %>%); pace <%= tr.weekly_rate_pct %>%/week (4 wks)</td></tr>
  <tr><th>BMI</th><td><%= @o.targets.bmi || "—" %></td></tr>
  <tr><th>Protein</th><td>7-day average <%= @o.protein_avg_7d %> g/day vs target <%= @o.targets.protein_g %> g</td></tr>
  <tr><th>Strength training</th><td><%= @o.strength_14d %> sessions in 14 days</td></tr>
  <tr><th>Estimated lean-mass share of loss</th><td><%= pct(@o.muscle.shown_share) %> (<%= @o.muscle.from_readings? ? "from body-fat readings" : "estimated" %>)</td></tr>
</table>
<h2 style="font-size:1.15rem">Side effects (30 days)</h2>
<table><thead><tr><th>Symptom</th><th>Days logged</th><th>Worst severity</th></tr></thead><tbody>
  <% @o.coach.top_symptoms.each do |sym, n, worst| %><tr><td><%= symptom_label(sym) %></td><td><%= n %></td><td><%= %w[- mild bothersome severe][worst] %></td></tr><% end %>
</tbody></table>
<% if (p = @o.coach.pattern_note) %><p><%= p %></p><% end %>
<h2 style="font-size:1.15rem;margin-top:16px">Questions to discuss</h2>
<ul>
  <li><%= s.escalation_note(recent_severe_side_effects: @o.coach.severe_recently?) %></li>
  <% @o.alerts.each do |_, title, body| %><li><strong><%= title %>:</strong> <%= body %></li><% end %>
  <li>Long-term plan: maintenance dose, taper, or stop — and how we’ll watch for regain.</li>
</ul>
